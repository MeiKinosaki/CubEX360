{
  "schema_version": 2,
  "rom_directory": "games/roms",
  "cover_directory": "games/covers",
  "save_state_directory": "saves/states",
  "favorites": [],
  "games": [],
  "cover_download": {
    "enabled": true,
    "only_if_missing": true,
    "base_url": "https://YOUR-COVER-SERVER.example/gamecube",
    "filename_pattern": "{GAMEID}.png",
    "network": ["ethernet", "wifi"],
    "require_valid_game_id": true,
    "max_download_bytes": 2097152,
    "timeout_seconds": 15
  }
}
